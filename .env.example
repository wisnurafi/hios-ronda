# Discord bot token (https://discord.com/developers/applications)
BOT_TOKEN=

# Text channel ID for live notifications (with @here ping)
NOTIFY_CHANNEL_ID=1400349914155847744

# Grace period (ms) before the bot leaves after a stream stops.
# Absorbs accidental Go Live toggles / brief disconnects.
LEAVE_GRACE_MS=5000

# Bot owner user IDs (comma-separated). Owners bypass the Administrator
# requirement on the /honeypot and /watch dashboards.
# Example: OWNER_IDS=1063828230601183383,987654321098765432
#OWNER_IDS=

# ------------------------------------------------------------------
# CUSTOM STATUS — what people see under the bot's name.
# (Same style as hios-bot. Applied on startup; while the bot is
#  watching someone live it temporarily shows "Watching <name> live"
#  and returns to this when idle.)
# ------------------------------------------------------------------

# STATUS_TEXT: the visible text.
#   - For STATUS_TYPE=custom : the bubble text, e.g. "thinking about you"
#   - For other types        : the activity name, e.g. "Minecraft" shows as
#                              "Playing Minecraft" / "Watching Minecraft"
STATUS_TEXT=on patrol

# STATUS_TYPE: activity type. Number or name — both work:
#   0 = playing    → "Playing <text>"
#   1 = streaming  → "Streaming <text>"  (needs STATUS_URL below!)
#   2 = listening  → "Listening to <text>"
#   3 = watching   → "Watching <text>"
#   4 = custom     → bubble text "<text>" (like "thinking about you")
#   5 = competing  → "Competing in <text>"
STATUS_TYPE=4

# STATUS_URL: stream URL, ONLY used when STATUS_TYPE=streaming (1).
#   Must be a valid Twitch or YouTube URL, otherwise Discord won't
#   render it as "Streaming" (falls back to "Playing").
#   Example: STATUS_URL=https://www.twitch.tv/somechannel
#STATUS_URL=

# STATUS_MODE: the colored dot next to the bot's name.
#   online    → green dot
#   idle      → yellow moon
#   dnd       → red "do not disturb"
#   invisible → appears offline (bot still works!)
STATUS_MODE=online
